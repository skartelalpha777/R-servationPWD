{% extends 'base.html.twig' %}

{% block title %}Show{% endblock %}

{% block body %}
    <h1>Show</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ show.id }}</td>
            </tr>
            <tr>
                <th>Slug</th>
                <td>{{ show.slug }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ show.title }}</td>
            </tr>
            <tr>
                <th>Poster_URL</th>
                <td>{{ show.posterURL }}</td>
            </tr>
            <tr>
                <th>Duration</th>
                <td>{{ show.duration }}</td>
            </tr>
            <tr>
                <th>Created_in</th>
                <td>{{ show.createdIn ? show.createdIn|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Bookable</th>
                <td>{{ show.bookable ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_show_index') }}">back to list</a>

    <a href="{{ path('app_show_edit', {'id': show.id}) }}">edit</a>

    {{ include('show/_delete_form.html.twig') }}
{% endblock %}
