{% extends 'base.html.twig' %}

{% block title %}Show index{% endblock %}

{% block body %}
    <h1>Show index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Slug</th>
                <th>Title</th>
                <th>Poster_URL</th>
                <th>Duration</th>
                <th>Created_in</th>
                <th>Bookable</th>
                <th>location</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for show in shows %}
            <tr>
                <td>{{ show.id }}</td>
                <td>{{ show.slug }}</td>
                <td>{{ show.title }}</td>
                <td>{{ show.posterURL }}</td>
                <td>{{ show.duration }}</td>
                <td>{{ show.createdIn ? show.createdIn|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ show.bookable ? 'Yes' : 'No' }}</td>
                <td>{{ show.location.designation }}</td>
                <td>
                    <a href="{{ path('app_show_show', {'id': show.id}) }}">show</a>
                    <a href="{{ path('app_show_edit', {'id': show.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_show_new') }}">Create new</a>
{% endblock %}
